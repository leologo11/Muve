PORT=4000
DATABASE_PROVIDER=supabase
FRONTEND_URL=http://localhost:5173

# ── MongoDB (alternativa a Supabase) ─────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/muve?retryWrites=true&w=majority&appName=Cluster0

# ── Supabase (backend recomendado) ───────────────────────────────────────────
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.TU-PROYECTO.supabase.co:5432/postgres

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string_minimum_32_characters

# ── Cloudinary (subida de fotos) ─────────────────────────────────────────────
# Crea cuenta gratis en cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Claude AI (opcional — para funciones de IA) ───────────────────────────────
CLAUDE_API_KEY=sk-ant-api03-...

# ── Notificaciones de cotización al admin (todas opcionales) ──────────────────
# Telegram (recomendado): crea un bot con @BotFather, pega el token abajo y tu
#   chat_id (obtenlo en https://api.telegram.org/bot<TOKEN>/getUpdates tras
#   escribirle al bot). Varios destinos: TELEGRAM_CHAT_ID=123,456
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ntfy: instala la app ntfy, suscríbete a un topic único y ponlo aquí (y en Railway).
#       Sin NTFY_TOPIC no se envía ninguna notificación push.
NTFY_TOPIC=muve-cotizaciones-cambia-esto
# NTFY_SERVER=https://ntfy.sh          # cámbialo solo si usas un servidor ntfy propio
# NTFY_TOKEN=tk_xxx                    # solo si el topic es privado / requiere auth
PUBLIC_APP_URL=https://muveapp.cl
# WhatsApp Cloud API (oficial, mensaje DESDE el número de MUVE):
#   1. Meta Business + app en developers.facebook.com con el producto WhatsApp
#   2. Registra el número de MUVE en la WhatsApp Cloud API → copia el Phone number ID
#   3. Genera un token permanente (System User) con permiso whatsapp_business_messaging
#   4. Crea una plantilla (categoría Utility) con 6 variables {{1}}..{{6}} en este orden:
#      código · servicio+cliente · teléfono · ruta · precio · link al panel
#   ADMIN_WHATSAPP_TO admite varios: 56911111111,56922222222
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# ADMIN_WHATSAPP_TO=56912345678
# WHATSAPP_TEMPLATE_NAME=nueva_cotizacion
# WHATSAPP_TEMPLATE_LANG=es
# Webhook genérico (opcional)
# ADMIN_NOTIFICATION_WEBHOOK_URL=
