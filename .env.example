# ── SERVER ──
PORT=4000
FRONTEND_URL=http://localhost:5173

# ── MongoDB ──
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/routiflow?retryWrites=true&w=majority&appName=Cluster0

# ── JWT ──
JWT_SECRET=change_this_to_a_long_random_secret_string_min_32chars

# ── Cloudinary (crea cuenta gratis en cloudinary.com) ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Claude AI ──
CLAUDE_API_KEY=sk-ant-api03-...
